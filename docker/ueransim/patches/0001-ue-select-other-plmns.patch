+    // Automatic mode, TS 23.122 4.4.3.1.1 step (iv): any other PLMN that is
+    // not forbidden. Without this a UE never camps on a visited PLMN, so
+    // roaming (e.g. a 999/71 UE on a 999/70 cell) is impossible.
+    for (auto &plmn : plmns)
+    {
+        if (plmn == m_base->config->hplmn)
+            continue;
+        if (m_storage->forbiddenPlmnList->contains(plmn))
+            continue;
+        if (nas::utils::ServiceAreaListForbidsPlmn(m_storage->serviceAreaList->get(), nas::utils::PlmnFrom(plmn)))
+            continue;
+        bool alreadyCandidate = false;
+        for (auto &candidate : candidates)
+        {
+            if (candidate == plmn)
+            {
+                alreadyCandidate = true;
+                break;
+            }
+        }
+        if (!alreadyCandidate)
+            candidates.push_back(plmn);
+    }
+
     Plmn selected = candidates.empty() ? Plmn{} : candidates[0];
 
     if (!selected.hasValue())
